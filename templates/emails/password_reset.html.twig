<!doctype html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#f5f5f4;font-family:Arial,Helvetica,sans-serif;color:#292524;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;border:1px solid #e7e5e4;">
        <tr><td style="padding:28px;">
            <p style="margin:0 0 16px;font-size:20px;font-weight:bold;color:#b45309;">{{ config.siteName }}</p>
            <p style="margin:0 0 12px;">Bonjour{{ pseudo ? ' ' ~ pseudo }},</p>
            <p style="margin:0 0 20px;">Une réinitialisation du mot de passe de ton compte a été demandée. Le lien ci-dessous est valable {{ ttl }} minutes.</p>
            <p style="margin:0 0 20px;"><a href="{{ link }}" style="display:inline-block;background:#d97706;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:8px;font-weight:bold;">Choisir un nouveau mot de passe</a></p>
            <p style="margin:0 0 8px;font-size:12px;color:#78716c;">Ou copie ce lien : {{ link }}</p>
            <p style="margin:16px 0 0;font-size:12px;color:#78716c;">Si tu n'es pas à l'origine de cette demande, ignore cet email : ton mot de passe ne change pas.</p>
        </td></tr>
    </table>
</body>
</html>
