{% extends 'layout_narrow.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Mot de passe oublié{% endblock %}

{% block content %}
    <div class="card card-body space-y-5">
        <div class="space-y-1 text-center">
            <h1 class="text-xl font-bold">Mot de passe oublié</h1>
            <p class="text-sm text-stone-500 dark:text-stone-400">
                {% if step == 'account' %}Étape 1 sur 2 : ton nom de compte.{% elseif step == 'answer' %}Étape 2 sur 2 : ta réponse secrète.{% endif %}
            </p>
        </div>

        {% if error %}{{ ui.alert('danger', error, false) }}{% endif %}

        {% if step == 'account' %}
            <form method="post" action="{{ url('password_reset') }}" class="space-y-4">
                {{ csrf_field() }}
                {{ ui.field('account', 'Nom de compte', {autocomplete: 'username', autofocus: true}) }}
                <button type="submit" class="btn btn-primary w-full">Continuer</button>
            </form>

        {% elseif step == 'answer' %}
            <form method="post" action="{{ url('password_reset') }}" class="space-y-4">
                {{ csrf_field() }}
                <div class="rounded-lg bg-stone-100 px-4 py-3 text-sm dark:bg-stone-800">
                    <p class="text-xs text-stone-500 dark:text-stone-400">Question secrète</p>
                    <p class="font-medium text-stone-900 dark:text-stone-100">{{ account.question }}</p>
                </div>
                {{ ui.field('answer', 'Ta réponse', {autocomplete: 'off', autofocus: true}) }}
                <button type="submit" class="btn btn-primary w-full">Réinitialiser le mot de passe</button>
                <p class="text-center text-sm"><a class="link" href="{{ url('password_reset', {restart: 1}) }}">Ce n'est pas mon compte</a></p>
            </form>

        {% else %}
            {{ ui.alert('success', 'Ton mot de passe a été réinitialisé.', false) }}
            <div class="space-y-2 text-center">
                <p class="text-sm">Ton nouveau mot de passe :</p>
                <p class="rounded-lg bg-stone-100 px-4 py-3 font-mono text-lg font-semibold tracking-wider select-all dark:bg-stone-800">{{ password }}</p>
                <p class="text-xs text-stone-500 dark:text-stone-400">Note-le maintenant : il ne sera plus affiché. Tu pourras le changer depuis ton compte.</p>
            </div>
            <a class="btn btn-primary w-full" href="{{ url('login') }}" data-dialog-open="login-dialog">Se connecter</a>
        {% endif %}
    </div>
{% endblock %}
