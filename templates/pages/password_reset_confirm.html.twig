{% extends 'layout_narrow.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block content %}
    <div class="card card-body space-y-5">
        <div class="space-y-1 text-center">
            <h1 class="text-xl font-bold">Choisis un nouveau mot de passe</h1>
            <p class="text-sm text-stone-500 dark:text-stone-400">Il servira aussi pour te connecter en jeu.</p>
        </div>
        {% if error %}{{ ui.alert('danger', error, false) }}{% endif %}
        <form method="post" action="{{ url('password_reset_confirm', params) }}" class="space-y-4">
            {{ csrf_field() }}
            {{ ui.field('password', 'Nouveau mot de passe', {type: 'password', autocomplete: 'new-password', maxlength: 50, autofocus: true, hint: 'De 6 à 50 caractères, sans accents ni émojis.'}) }}
            {{ ui.field('password_confirm', 'Confirmation', {type: 'password', autocomplete: 'new-password', maxlength: 50}) }}
            <button type="submit" class="btn btn-primary w-full">Enregistrer</button>
        </form>
    </div>
{% endblock %}
