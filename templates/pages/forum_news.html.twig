{% extends 'layout.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Nouvelles du forum{% endblock %}

{% block content %}
    {{ ui.page_header('Nouvelles du forum', 'Les derniers sujets publiés sur le forum.') }}

    {% if not configured %}
        {{ ui.empty('Le flux du forum n\'est pas configuré.') }}
    {% else %}
        {% for item in items %}
            <article class="card card-body space-y-1.5">
                <h2 class="font-semibold">
                    {% if item.link %}<a class="hover:text-brand-700 dark:hover:text-brand-300" href="{{ item.link }}" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
                </h2>
                {% if item.date %}<p class="text-xs text-stone-500 dark:text-stone-400">{{ item.date|date_fr }}</p>{% endif %}
                {% if item.summary %}<p class="text-sm">{{ item.summary }}</p>{% endif %}
            </article>
        {% else %}
            {{ ui.empty('Aucune nouvelle du forum pour le moment.') }}
        {% endfor %}
    {% endif %}
{% endblock %}
