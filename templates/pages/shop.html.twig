{% extends 'layout.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Boutique{% if category %} : {{ category.name }}{% endif %}{% endblock %}

{% block content %}
    <div class="flex flex-wrap items-end justify-between gap-4">
        {{ ui.page_header('Boutique', 'Les objets achetés sont livrés en jeu à ta prochaine connexion.') }}
        <p class="text-sm">Solde : <span class="badge badge-brand text-sm tabular-nums">{{ current_account().points }} points</span></p>
    </div>

    {% if servers|length > 1 %}
        <nav class="flex flex-wrap gap-2" aria-label="Serveurs">
            {% for id, name in servers %}
                <a class="btn {{ id == server ? 'btn-primary' : 'btn-secondary' }}" href="{{ url('shop_server', {server: id}) }}" {% if id == server %}aria-current="page"{% endif %}>{{ name }}</a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if server is null %}
        {{ servers ? ui.empty('Choisis un serveur.') : ui.empty('La boutique est vide pour le moment.') }}
    {% else %}
        <nav class="flex flex-wrap gap-2" aria-label="Catégories">
            {% for row in categories %}
                {% set active = category and row.id == category.id %}
                <a href="{{ url('shop_category', {server: server, category: row.id}) }}" {% if active %}aria-current="page"{% endif %}
                   class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition-colors {{ active ? 'border-brand-600 bg-brand-600 text-white dark:border-brand-500 dark:bg-brand-500 dark:text-stone-950' : 'border-stone-300 bg-white hover:border-brand-400 dark:border-stone-700 dark:bg-stone-900' }}">
                    {{ row.name }} <span class="text-xs opacity-70 tabular-nums">{{ row.items }}</span>
                </a>
            {% else %}
                {{ ui.empty('Aucun objet en vente sur ce serveur.') }}
            {% endfor %}
        </nav>

        {% if category is null %}
            {% if categories %}{{ ui.empty('Choisis une catégorie.') }}{% endif %}
        {% else %}
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {% for item in items %}
                    {% set effects = item.effects|item_effects %}
                    <article class="card flex flex-col">
                        <div class="card-body flex-1 space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="font-semibold">{{ item.name }}</h2>
                                <span class="badge badge-neutral shrink-0">Niv. {{ item.level }}</span>
                            </div>
                            {% if effects %}
                                <ul class="space-y-0.5 text-xs text-stone-600 dark:text-stone-400">
                                    {% for effect in effects|slice(0, 5) %}<li>{{ effect }}</li>{% endfor %}
                                    {% if effects|length > 5 %}<li class="text-stone-400">+ {{ effects|length - 5 }} autre{{ effects|length - 5 > 1 ? 's' }}</li>{% endif %}
                                </ul>
                            {% endif %}
                            {% if item.jp %}<span class="badge badge-success">Jet parfait</span>{% endif %}
                        </div>
                        <div class="flex items-center justify-between gap-3 border-t border-stone-100 px-5 py-3 dark:border-stone-800">
                            <span class="font-semibold tabular-nums">{{ item.price }} pts</span>
                            <a class="btn btn-secondary btn-sm" href="{{ url('shop_item', {server: server, template: item.template}) }}">Voir</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
