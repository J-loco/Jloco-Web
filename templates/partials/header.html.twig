{% set account = current_account() %}
{% set route = current_route ?? '' %}
{% set nav = [
    {route: 'home', label: 'Actualités', active: route == 'home'},
    {route: 'ladder', label: 'Classements', active: route starts with 'ladder'},
    {route: 'drops', label: 'Drops', active: route == 'drops'},
    {route: 'shop', label: 'Boutique', active: route starts with 'shop', auth: true},
    {route: 'vote', label: 'Voter', active: route == 'vote'},
    {route: 'join', label: 'Nous rejoindre', active: route == 'join'},
] %}

<header class="site-header sticky top-0 z-40">
    <div class="container-page flex h-16 items-center gap-4">
        <a href="{{ url('home') }}" class="brand-lockup" aria-label="{{ config.siteName }}, accueil">
            <span class="brand-mark" aria-hidden="true"><i></i></span>
            <span class="brand-name">STAR<span>LOCO</span></span>
            <span class="brand-edition">RETRO</span>
        </a>

        <nav class="hidden h-full items-stretch lg:flex" aria-label="Navigation principale">
            {% for item in nav %}
                {% if not item.auth|default(false) or account %}
                    <a class="nav-link" href="{{ url(item.route) }}" {% if item.active %}aria-current="page"{% endif %}>{{ item.label }}</a>
                {% endif %}
            {% endfor %}
            {% if config.forumUrl %}
                <a class="nav-link" href="{{ config.forumUrl }}" rel="noopener">Forum</a>
            {% endif %}
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
            {% if account %}
                <details class="relative" data-menu>
                    <summary class="btn btn-secondary list-none [&::-webkit-details-marker]:hidden">
                        <span class="max-w-32 truncate">{{ account.pseudo ?: 'Mon compte' }}</span>
                        <span class="badge badge-brand tabular-nums" title="Points boutique">{{ account.points }} pts</span>
                    </summary>
                    <div class="card absolute right-0 mt-2 w-52 p-1.5 text-sm">
                        <a class="menu-link" href="{{ url('account') }}">Mon compte</a>
                        <a class="menu-link" href="{{ url('shop') }}">Boutique</a>
                        {% if is_admin() %}<a class="menu-link" href="{{ url('admin') }}">Administration</a>{% endif %}
                        <form method="post" action="{{ url('logout') }}" class="mt-1 border-t border-stone-800 pt-1">
                            {{ csrf_field() }}
                            <button type="submit" class="menu-link menu-link-danger w-full text-left">Déconnexion</button>
                        </form>
                    </div>
                </details>
            {% else %}
                <a class="btn btn-ghost hidden sm:inline-flex" href="{{ url('login') }}" data-dialog-open="login-dialog">Connexion</a>
                <a class="btn btn-primary hidden sm:inline-flex" href="{{ url('register') }}">Créer un compte</a>
            {% endif %}

            <details class="mobile-nav relative" data-menu>
                <summary class="mobile-nav-button list-none [&::-webkit-details-marker]:hidden" aria-label="Menu">
                    <span aria-hidden="true">☰</span>
                </summary>
                <nav class="card absolute right-0 mt-2 w-56 p-1.5 text-sm" aria-label="Navigation mobile">
                    {% for item in nav %}
                        {% if not item.auth|default(false) or account %}
                            <a class="menu-link {{ item.active ? 'active' }}" href="{{ url(item.route) }}" {% if item.active %}aria-current="page"{% endif %}>{{ item.label }}</a>
                        {% endif %}
                    {% endfor %}
                    {% if config.forumUrl %}<a class="menu-link" href="{{ config.forumUrl }}" rel="noopener">Forum</a>{% endif %}
                    {% if not account %}
                        <a class="menu-link sm:hidden" href="{{ url('login') }}">Connexion</a>
                        <a class="menu-link sm:hidden" href="{{ url('register') }}">Créer un compte</a>
                    {% endif %}
                </nav>
            </details>
        </div>
    </div>
</header>
