{% import 'components/ui.html.twig' as ui %}
{% set data = sidebar() %}

<section class="card server-panel" aria-labelledby="sidebar-status">
    <div class="card-header">
        <div><p class="section-kicker">ÉTAT DU ROYAUME</p><h2 id="sidebar-status" class="card-title">Serveur {{ data.game.name }}</h2></div>
        <span class="live-badge {{ data.game.online ? '' : 'offline' }}">{{ data.game.online ? 'LIVE' : 'HORS LIGNE' }}</span>
    </div>
    <div class="players-spotlight">
        <div>
            <strong>{{ data.game.online ? data.game.players : '–' }}</strong>
            <span>aventurier{{ data.game.players > 1 ? 's' }} en ligne</span>
        </div>
        <img src="{{ asset('assets/img/launcher/pet.png') }}" alt="" width="96" height="95">
    </div>
    <ul class="server-list divide-y divide-stone-100 text-sm dark:divide-stone-800">
        <li class="flex items-center gap-3 px-5 py-3">
            <div class="flex-1">
                <p class="font-medium text-stone-900 dark:text-stone-100">Connexion</p>
                <p class="text-xs text-stone-500 dark:text-stone-400">{{ data.loginOnline ? 'En ligne' : 'Hors ligne' }}</p>
            </div>
            {{ ui.status_dot(data.loginOnline) }}
        </li>
        <li class="flex items-center gap-3 px-5 py-3">
            <div class="flex-1">
                <p class="font-medium text-stone-900 dark:text-stone-100">{{ data.game.name }}</p>
                <p class="text-xs text-stone-500 dark:text-stone-400">
                    {% if data.game.online %}
                        En ligne{% if data.game.uptime %} · depuis {{ data.game.uptime }}{% endif %}
                    {% else %}
                        Hors ligne
                    {% endif %}
                </p>
            </div>
            {{ ui.status_dot(data.game.online) }}
        </li>
    </ul>
</section>

<a href="{{ url('vote') }}" class="card group block space-y-2 p-4 text-center transition-colors hover:border-brand-300 dark:hover:border-brand-500/40">
    <img class="mx-auto h-auto w-full max-w-60 rounded-md bg-white p-1" src="{{ asset('assets/img/rpg.jpg') }}" alt="Voter sur RPG Paradize" width="300" height="50">
    <span class="block text-xs text-stone-500 group-hover:text-brand-700 dark:text-stone-400 dark:group-hover:text-brand-300">Vote et gagne {{ config.votePoints }} points boutique toutes les 3 h</span>
</a>

<section class="card" aria-labelledby="sidebar-stats">
    <div class="card-header"><h2 id="sidebar-stats" class="card-title">Statistiques</h2></div>
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-b-xl bg-white/5 text-center">
        {% for label, value in {'Comptes': data.stats.accounts, 'Personnages': data.stats.characters, 'Guildes': data.stats.guilds, 'Objets': data.stats.objects} %}
            <div class="bg-[#1a2019] px-3 py-3">
                <dt class="text-xs text-stone-500 dark:text-stone-400">{{ label }}</dt>
                <dd class="text-lg font-semibold text-stone-900 tabular-nums dark:text-stone-100">{{ value|number_format(0, ',', ' ') }}</dd>
            </div>
        {% endfor %}
    </dl>
</section>

{% if data.podium %}
    <section class="card" aria-labelledby="sidebar-podium">
        <div class="card-header">
            <h2 id="sidebar-podium" class="card-title">Top 3 des joueurs</h2>
            <a class="link text-xs" href="{{ url('ladder') }}">Classement</a>
        </div>
        <ol class="space-y-3 px-5 py-4 text-sm">
            {% for entry in data.podium %}{% set player = entry.character %}
                <li class="flex gap-3">
                    <span class="grid size-7 shrink-0 place-items-center rounded-full text-xs font-bold {{ ['bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300', 'bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-200', 'bg-orange-100 text-orange-800 dark:bg-orange-500/20 dark:text-orange-300'][loop.index0] }}">{{ loop.index }}</span>
                    <div class="min-w-0">
                        <p class="truncate font-medium text-stone-900 dark:text-stone-100">{{ player.name }}</p>
                        <p class="text-xs text-stone-500 dark:text-stone-400">
                            {{ player|breed }} niveau {{ player.level }}{% if entry.place %} · {{ entry.place.name }}{% endif %}
                        </p>
                    </div>
                </li>
            {% endfor %}
        </ol>
    </section>
{% endif %}

{% if data.wanted %}
    <section class="card border-red-200 dark:border-red-500/30" aria-labelledby="sidebar-wanted">
        <div class="card-header border-red-100 dark:border-red-500/20">
            <h2 id="sidebar-wanted" class="card-title text-red-700 dark:text-red-300">Avis de recherche</h2>
            <span class="badge badge-danger tabular-nums">{{ data.wanted|length }}</span>
        </div>
        <ul class="space-y-3 px-5 py-4 text-sm">
            {% for entry in data.wanted %}{% set player = entry.character %}
                <li>
                    <p class="font-medium text-stone-900 dark:text-stone-100">{{ player.name }} <span class="font-normal text-stone-500 dark:text-stone-400">· {{ player|breed }} niveau {{ player.level }}</span></p>
                    <p class="text-xs text-stone-500 dark:text-stone-400">
                        {% if entry.place %}
                            Vu récemment : {{ entry.place.name }} [{{ entry.place.x }}, {{ entry.place.y }}]
                        {% else %}
                            Position inconnue
                        {% endif %}
                    </p>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
