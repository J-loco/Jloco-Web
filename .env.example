# Only needed when running StarLoco-Web outside docker compose: real environment variables win.
# With docker compose, set the WEB_* equivalents in StarLoco-Game/.env instead.

# Public URL of the portal (trailing slash). Its path must match APP_BASE_PATH in the Apache config.
APP_URL=http://127.0.0.1/dofus/
APP_DEBUG=0
# 1 only behind Cloudflare: otherwise the client IP (votes, throttling) can be forged.
TRUST_CLOUDFLARE=0

SITE_NAME=StarLoco
# world_accounts.guid of the account that can open /admin.
ADMIN_ACCOUNT_ID=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=starloco_web
DB_PASS=
LOGIN_DB_NAME=starloco_login
GAME_DB_NAME=starloco_game

# Status probes (sidebar, launcher/status.php).
LOGIN_HOST=127.0.0.1
LOGIN_PORT=450
GAME_HOST=127.0.0.1
GAME_PORT=5555
# world_servers.id of the game server (name, uptime, players online).
GAME_SERVER_ID=601

# Optional links (empty = hidden).
FORUM_URL=
FORUM_RSS_URL=
DOWNLOAD_URL=

VOTE_URL=https://www.rpg-paradize.com/
VOTE_POINTS=5
# Empty hides the "Recharger des points" section.
DEDIPASS_PUBLIC_KEY=
