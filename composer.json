{
    "name": "starloco/web",
    "description": "StarLoco web portal (registration, shop, ladder) and launcher endpoints",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "StarLoco\\Web\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
