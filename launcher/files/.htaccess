# The launcher payload is static game data. Never let anything under files/ be
# interpreted as a script, whatever ends up in the tree.
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

# status.php / news.php live in the parent directory, so turning the engine off
# here only affects files/.
